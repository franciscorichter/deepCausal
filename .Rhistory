ui <- fluidPage(
titlePanel("DAG Creation: Finalize & Display Adjacency + Structural Equations"),
# Use MathJax for nice LaTeX
withMathJax(),
fluidRow(
column(width = 4,
h4("1) Create / Edit Nodes"),
numericInput("num_x", "Number of X nodes:",
value = 3, min = 1, max = 50),
numericInput("num_a", "Number of A (intervention) nodes:",
value = 1, min = 0, max = 10),
actionButton("create_nodes", "Create / Reset Graph"),
br(), br(),
helpText("After creating nodes, click 'Edit' on the graph (top-left).",
"Then use 'Add Edge' to draw edges (parent -> child). ",
"Finally, click 'Done with Network Drawing' below."),
# The button to finalize adjacency
actionButton("finalize_btn", "Done with Network Drawing")
),
column(width = 8,
# The visNetwork for DAG drawing
visNetworkOutput("graph", height = "400px"),
# Once the user finalizes, we show:
