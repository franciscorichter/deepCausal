)
server <- function(input, output, session) {
# Reactive storage for the "live" (editable) graph
rv_nodes <- reactiveVal(NULL)
rv_edges <- reactiveVal(NULL)
# Reactive storage for the "finalized" adjacency
final_adjacency <- reactiveVal(NULL)
final_node_ids  <- reactiveVal(NULL)
#-----------------------
# 1) Create / Reset Graph
#-----------------------
observeEvent(input$create_nodes, {
nX <- input$num_x
nA <- input$num_a
x_nodes <- paste0("X_", seq_len(nX))
a_nodes <- paste0("A_", seq_len(nA))
y_node  <- "Y"
all_nodes <- c(x_nodes, a_nodes, y_node)
nodes_df <- data.frame(
id    = all_nodes,
label = all_nodes,
group = c(rep("X", nX), rep("A", nA), "Y"),
stringsAsFactors = FALSE
)
edges_df <- data.frame(from = character(0), to = character(0),
stringsAsFactors = FALSE)
rv_nodes(nodes_df)
rv_edges(edges_df)
final_adjacency(NULL)
final_node_ids(NULL)
})
#-----------------------
# 2) Render the visNetwork
#-----------------------
output$graph <- renderVisNetwork({
req(rv_nodes(), rv_edges())
visNetwork(rv_nodes(), rv_edges()) %>%
# Show arrowheads
visEdges(arrows = "to") %>%
# Color groups
visGroups(groupname = "X", color = list(background = "#A0C8F0", border = "#000000")) %>%
visGroups(groupname = "A", color = list(background = "#90EE90", border = "#000000")) %>%
visGroups(groupname = "Y", color = list(background = "#FFD700", border = "#000000")) %>%
# Turn on manipulation
visOptions(manipulation = TRUE) %>%
visInteraction(navigationButtons = TRUE)
})
# Update rv_edges whenever user manipulates edges
observeEvent(input$graph_edges, {
if (is.null(input$graph_edges)) {
rv_edges(data.frame(from=character(0), to=character(0), stringsAsFactors=FALSE))
} else {
edges_df <- data.frame(
from = sapply(input$graph_edges, `[[`, "from"),
to   = sapply(input$graph_edges, `[[`, "to"),
stringsAsFactors = FALSE
)
rv_edges(edges_df)
}
})
#-------------------------------------
# 3) Finalize adjacency on button press
#-------------------------------------
observeEvent(input$finalize_btn, {
req(rv_nodes(), rv_edges())
node_ids <- rv_nodes()$id
edges_df <- rv_edges()
# Build adjacency: adjacency[[child]] = parents
adjacency_list <- lapply(node_ids, function(child) {
edges_df$from[edges_df$to == child]
})
names(adjacency_list) <- node_ids
final_adjacency(adjacency_list)
final_node_ids(node_ids)
})
#-------------------------------------
# 4) Display the finalized adjacency
#-------------------------------------
output$adjacency_out <- renderPrint({
adj <- final_adjacency()
if (is.null(adj)) {
cat("No finalized adjacency yet. Click 'Done with Network Drawing' first.\n")
} else {
cat("adjacency[[child]] = c(parents...)\n\n")
print(adj)
}
})
#-------------------------------------
# 5) Display structural equations
#-------------------------------------
output$equations_out <- renderUI({
adj <- final_adjacency()
node_ids <- final_node_ids()
if (is.null(adj) || is.null(node_ids)) {
return("No finalized adjacency yet.")
}
# For each node, equation: child = sum_of_parents + epsilon
eq_list <- lapply(node_ids, function(child) {
pars <- adj[[child]]
if (length(pars) == 0) {
# e.g. $$ X_1 = \varepsilon_{X_1} $$
paste0("$$", child, " = \\varepsilon_{", child, "}$$")
} else {
# e.g. $$ X_2 = X_1 + \varepsilon_{X_2} $$
rhs <- paste(c(pars, paste0("\\varepsilon_{", child, "}")), collapse = " + ")
paste0("$$", child, " = ", rhs, "$$")
}
})
tagList(
lapply(eq_list, function(eq) {
div(eq)
})
)
})
}
shinyApp(ui, server)
