"  callback(edgeData);",      # accept the edge
"}"
),
deleteEdge = TRUE
)
)
})
#==========================
# 3) Track edges in rv_edges
#==========================
observeEvent(input$graph_edges, {
ed <- input$graph_edges
if (is.null(ed)) {
rv_edges(data.frame(from=character(0), to=character(0), stringsAsFactors=FALSE))
} else {
edges_df <- data.frame(
from = sapply(ed, `[[`, "from"),
to   = sapply(ed, `[[`, "to"),
stringsAsFactors = FALSE
)
rv_edges(edges_df)
}
})
#==========================
# 4) Display Structural Equations & DAG check
#==========================
# Build adjacency: adjacency[[child]] = parents
# Then show equations in LaTeX
output$equations_ui <- renderUI({
req(rv_nodes(), rv_edges())
node_ids <- rv_nodes()$id
edges_df <- rv_edges()
# adjacency
adjacency <- lapply(node_ids, function(child) {
edges_df$from[edges_df$to == child]
})
names(adjacency) <- node_ids
eq_lines <- lapply(node_ids, function(child) {
parents <- adjacency[[child]]
if (length(parents) == 0) {
# $$ X_1 = \varepsilon_{X_1} $$
paste0("$$ ", child, " = \\varepsilon_{", child, "} $$")
} else {
# $$ X_2 = X_1 + \varepsilon_{X_2} $$
rhs <- paste(c(parents, paste0("\\varepsilon_{", child, "}")), collapse = " + ")
paste0("$$ ", child, " = ", rhs, " $$")
}
})
tagList(lapply(eq_lines, function(eq) div(eq)))
})
# Check for cycles (topological sort). If a cycle exists, we show a warning.
output$dag_check_ui <- renderUI({
req(rv_nodes(), rv_edges())
node_ids <- rv_nodes()$id
edges_df <- rv_edges()
adjacency <- lapply(node_ids, function(child) {
edges_df$from[edges_df$to == child]
})
names(adjacency) <- node_ids
sorted_nodes <- character(0)
# naive topological sort
for (i in seq_along(node_ids)) {
can_add <- setdiff(
names(adjacency)[sapply(adjacency, function(pars) all(pars %in% sorted_nodes))],
sorted_nodes
)
if (length(can_add) == 0) break
sorted_nodes <- c(sorted_nodes, can_add)
}
if (length(sorted_nodes) < length(node_ids)) {
# cycle or unreachable
tags$div(style="color:red; font-weight:bold;",
"Warning: The graph contains a cycle (not a valid DAG).
Structural equations are not well-defined!")
} else {
tags$div(style="color:green; font-weight:bold;",
"DAG check passed: no cycles detected.")
}
})
#==========================
# 5) Simulate data from the DAG
#==========================
observeEvent(input$simulate_data, {
req(rv_nodes(), rv_edges())
node_ids <- rv_nodes()$id
edges_df <- rv_edges()
n <- input$sample_size
# build adjacency
adjacency <- lapply(node_ids, function(child) {
edges_df$from[edges_df$to == child]
})
names(adjacency) <- node_ids
# topological sort or fail
sorted_nodes <- character(0)
for (i in seq_along(node_ids)) {
can_add <- setdiff(
names(adjacency)[sapply(adjacency, function(pars) all(pars %in% sorted_nodes))],
sorted_nodes
)
if (length(can_add) == 0) {
showNotification("Error: The graph has a cycle; cannot simulate data from cycles.")
return(NULL)
}
sorted_nodes <- c(sorted_nodes, can_add)
}
# Compute each node as sum of parents + rnorm
df <- as.data.frame(matrix(NA, nrow = n, ncol = length(node_ids)))
colnames(df) <- node_ids
for (child in sorted_nodes) {
pars <- adjacency[[child]]
if (length(pars) == 0) {
df[[child]] <- rnorm(n)
} else {
df[[child]] <- rowSums(df[, pars, drop=FALSE]) + rnorm(n)
}
}
simulated_data(df)
})
#==========================
# 6) Show data preview
#==========================
output$data_preview <- renderTable({
req(simulated_data())
head(simulated_data(), 10)
})
#==========================
# 7) Download CSV
#==========================
output$download_data <- downloadHandler(
filename = function() {
"simulated_data.csv"
},
content = function(file) {
req(simulated_data())
write.csv(simulated_data(), file, row.names = FALSE)
}
)
}
shinyApp(ui, server)
